<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The admin panel (MVC). Uses the same business rules as the app through modaar.core; has its
       own cookie sign-in for admin accounts. Sends no notifications for now. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>modaar.admin</RootNamespace>
    <UserSecretsId>modaar-admin-7d1f3c2a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\modaar.core\modaar.core.csproj" />
  </ItemGroup>

</Project>
