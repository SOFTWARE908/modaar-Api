{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ModaarDb": "Server=10.110.0.2;Database=modaar_dev;User Id=modaar;Password=modaar;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "JwtSettings": {
    "Issuer": "modaar.api",
    "Audience": "modaar.app",
    "SigningKey": "your-signing-key-here",
    "AccessTokenExpiresMinutes": 60,
    "RefreshTokenExpiresDays": 30
  },
  "OtpSettings": {
    "LengthDigits": 6,
    "ExpiresInMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 30,
    "UseFixedCode": false,
    "FixedCode": "123456"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/modaar-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
