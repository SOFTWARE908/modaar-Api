  "components": {
    "schemas": {
      "AccountType": {
        "enum": [
          "owner",
          "tenant",
          "broker",
          "technician"
        ],
        "type": "string"
      },
      "AuthSuccessResponseDto": {
        "required": [
          "accessToken",
          "accountType",
          "isNewUser",
          "profileStatus",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "nullable": true
          },
          "refreshToken": {
            "type": "string",
            "nullable": true
          },
          "accountType": {
            "$ref": "#/components/schemas/AccountType"
          },
          "isNewUser": {
            "type": "boolean"
          },
          "profileStatus": {
            "$ref": "#/components/schemas/ProfileStatus"
          }
        },
        "additionalProperties": false
      },
      "BrokerSummaryDto": {
        "required": [
          "id",
          "isVerified",
          "name",
          "ratingAverage",
          "reviewsCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "nullable": true
          },
          "subtitle": {
            "type": "string",
            "nullable": true
          },
          "ratingAverage": {
            "type": "number",
            "format": "double"
          },
          "reviewsCount": {
            "type": "integer",
            "format": "int32"
          },
          "isVerified": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ContractRenewalAvailability": {
        "enum": [
          "available",
          "unavailable",
          "pending"
        ],
        "type": "string"
      },
      "ContractStatus": {
        "enum": [
          "active",
          "expired",
          "terminated"
        ],
        "type": "string"
      },
      "CreatePropertyRequestDto": {
        "required": [
          "annualRent",
          "propertyType",
          "roomsCount",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "propertyType": {
            "$ref": "#/components/schemas/PropertyType"
          },
          "roomsCount": {
            "type": "integer",
            "format": "int32"
          },
          "annualRent": {
            "type": "number",
            "format": "double"
          },
          "addressLine": {
            "type": "string",
            "nullable": true
          },
          "district": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "coverImageUrl": {
            "type": "string",
            "nullable": true
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyImageDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginMethod": {
        "enum": [
          "emailPassword",
          "phoneOtp",
          "nationalIdOtp"
        ],
        "type": "string"
      },
      "LoginRequestDto": {
        "required": [
          "loginMethod"
        ],
        "type": "object",
        "properties": {
          "loginMethod": {
            "$ref": "#/components/schemas/LoginMethod"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "countryCode": {
            "type": "string",
            "nullable": true
          },
          "nationalId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MaintenanceRequestStatus": {
        "enum": [
          "pending",
          "accepted",
          "onTheWay",
          "inProgress",
          "completed",
          "rejected",
          "cancelled"
        ],
        "type": "string"
      },
      "MaintenanceServiceType": {
        "enum": [
          "cleaning",
          "paintRepair",
          "appliances",
          "ac"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "ProfileStatus": {
        "enum": [
          "incomplete",
          "complete"
        ],
        "type": "string"
      },
      "PropertyDetailsDto": {
        "required": [
          "handoverImageUrls",
          "imageUrls",
          "maintenanceHistory",
          "summary"
        ],
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/PropertySummaryDto"
          },
          "tenantContract": {
            "$ref": "#/components/schemas/PropertyTenantContractDto"
          },
          "broker": {
            "$ref": "#/components/schemas/BrokerSummaryDto"
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "handoverImageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "handoverDescription": {
            "type": "string",
            "nullable": true
          },
          "maintenanceHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyMaintenanceHistoryItemDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PropertyImageDto": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "nullable": true
          },
          "caption": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PropertyListItemDto": {
        "required": [
          "annualRent",
          "currency",
          "id",
          "status",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/PropertyRentalStatus"
          },
          "monthlyRent": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "annualRent": {
