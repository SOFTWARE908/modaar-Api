# Visual Studio state and per-user settings
.vs/
*.suo
*.user
*.userprefs

# Build output (any project)
[Bb]in/
[Oo]bj/

# EF Core migration bundle — built with `dotnet ef migrations bundle`, never committed
efbundle*

# Serilog output
/modaar.api/Logs/
*.log

# Generated by `dotnet ef migrations script` — regenerate, don't commit (see README)
/*.sql

# Secrets: service-account keys and local overrides never belong in the repo
*firebase-adminsdk*.json
appsettings.*.local.json
*.pfx

# Test results and coverage
[Tt]est[Rr]esult*/
coverage*/

# Rider / VS Code
.idea/
.vscode/
